<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/chat_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<!-- Area Pesan Fullscreen di Belakang Header & Input Blur -->
	<ScrollView
		android:id="@+id/chat_scroll_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:paddingLeft="14dp"
		android:paddingTop="104dp"
		android:paddingRight="14dp"
		android:paddingBottom="116dp"
		android:scrollbars="none">

		<LinearLayout
			android:id="@+id/chat_messages_container"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />
	</ScrollView>

	<!-- Header Floating Glass (Tanpa angka 46, judul Live Chat, status online) -->
	<LinearLayout
		android:id="@+id/chat_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingLeft="14dp"
		android:paddingTop="12dp"
		android:paddingRight="14dp"
		android:paddingBottom="10dp">

		<FrameLayout
			android:id="@+id/btn_chat_back"
			android:layout_width="42dp"
			android:layout_height="42dp"
			android:layout_marginEnd="10dp">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/back_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<TextView
				android:id="@+id/text_chat_back_arrow"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:text="‹"
				android:textColor="#FFFFFF"
				android:textSize="22sp" />
		</FrameLayout>

		<FrameLayout
			android:id="@+id/chat_header_pill"
			android:layout_width="0dp"
			android:layout_height="44dp"
			android:layout_weight="1">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/header_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<LinearLayout
				android:id="@+id/chat_header_titles"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:orientation="vertical"
				android:paddingLeft="14dp"
				android:paddingRight="14dp">

				<TextView
					android:id="@+id/text_chat_title"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Live Chat"
					android:textColor="#FFFFFF"
					android:textSize="14.5sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/text_online_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="online"
					android:textColor="#22C55E"
					android:textSize="11sp"
					android:textStyle="bold" />
			</LinearLayout>
		</FrameLayout>
	</LinearLayout>

	<!-- Area Input Bawah dengan Blur Latar Belakang -->
	<LinearLayout
		android:id="@+id/chat_bottom_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:orientation="vertical"
		android:paddingLeft="14dp"
		android:paddingTop="8dp"
		android:paddingRight="14dp"
		android:paddingBottom="14dp">

		<!-- Banner Reply / Quote -->
		<LinearLayout
			android:id="@+id/reply_banner"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="6dp"
			android:background="#B3111827"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingLeft="12dp"
			android:paddingTop="7dp"
			android:paddingRight="12dp"
			android:paddingBottom="7dp"
			android:visibility="gone">

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:id="@+id/reply_target_author"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Membalas..."
					android:textColor="#38BDF8"
					android:textSize="11.5sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/reply_target_snippet"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:text="..."
					android:textColor="#CBD5E1"
					android:textSize="11.5sp" />
			</LinearLayout>

			<TextView
				android:id="@+id/btn_cancel_reply"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingStart="8dp"
				android:paddingEnd="4dp"
				android:text="✕"
				android:textColor="#94A3B8"
				android:textSize="15sp" />
		</LinearLayout>

		<!-- Preview Stiker Terpilih -->
		<LinearLayout
			android:id="@+id/sticker_preview_box"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="6dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:visibility="gone">

			<ImageView
				android:id="@+id/sticker_preview_img"
				android:layout_width="58dp"
				android:layout_height="58dp"
				android:scaleType="fitCenter" />

			<TextView
				android:id="@+id/btn_remove_sticker"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:text="✕"
				android:textColor="#EF4444"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>

		<!-- Dropdown Mention @username -->
		<LinearLayout
			android:id="@+id/mention_menu"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="6dp"
			android:background="#CC0B1329"
			android:orientation="vertical"
			android:padding="6dp"
			android:visibility="gone" />

		<!-- Baris Input Ketik Pesan + Stiker + Kirim dengan Blur Belakang -->
		<FrameLayout
			android:id="@+id/chat_input_glass_wrapper"
			android:layout_width="match_parent"
			android:layout_height="52dp">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/input_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<LinearLayout
				android:id="@+id/chat_input_row"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingLeft="16dp"
				android:paddingRight="6dp">

				<EditText
					android:id="@+id/chat_input"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:background="@android:color/transparent"
					android:hint="Kirim pesan... (ketik @ untuk tag)"
					android:inputType="text"
					android:singleLine="true"
					android:textColor="#FFFFFF"
					android:textColorHint="#94A3B8"
					android:textSize="14sp" />

				<FrameLayout
					android:id="@+id/btn_open_sticker"
					android:layout_width="38dp"
					android:layout_height="38dp"
					android:layout_marginEnd="6dp">

					<TextView
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center"
						android:text="☺"
						android:textColor="#E2E8F0"
						android:textSize="17sp" />
				</FrameLayout>

				<FrameLayout
					android:id="@+id/btn_send_chat"
					android:layout_width="40dp"
					android:layout_height="40dp">

					<TextView
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center"
						android:text="➤"
						android:textColor="#FFFFFF"
						android:textSize="14sp" />
				</FrameLayout>
			</LinearLayout>
		</FrameLayout>

		<!-- Panel Stiker & GIF -->
		<LinearLayout
			android:id="@+id/sticker_panel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:background="#D90B0F1A"
			android:orientation="vertical"
			android:padding="12dp"
			android:visibility="gone">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:text="Pilih Stiker &amp; GIF"
				android:textColor="#FFFFFF"
				android:textSize="13sp"
				android:textStyle="bold" />

			<HorizontalScrollView
				android:id="@+id/sticker_scroll_view"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">

				<LinearLayout
					android:id="@+id/sticker_grid_container"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal" />
			</HorizontalScrollView>
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
