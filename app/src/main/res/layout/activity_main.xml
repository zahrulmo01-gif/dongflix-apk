<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root_main_container"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/main_scroll_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:clipToPadding="false"
		android:paddingBottom="165dp">

		<LinearLayout
			android:id="@+id/linear81"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<RelativeLayout
				android:id="@+id/hero_container"
				android:layout_width="match_parent"
				android:layout_height="345dp">

				<ImageView
					android:id="@+id/img_hero_banner"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:src="@drawable/default_image"
					android:scaleType="centerCrop" />

				<View
					android:id="@+id/hero_shadow"
					android:layout_width="match_parent"
					android:layout_height="220dp"
					android:layout_alignParentBottom="true" />

				<View
					android:id="@+id/header_shadow"
					android:layout_width="match_parent"
					android:layout_height="120dp"
					android:layout_alignParentTop="true" />

				<RelativeLayout
					android:id="@+id/relativelayout69"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingTop="12dp"
					android:paddingRight="16dp"
					android:paddingBottom="12dp"
					android:layout_alignParentTop="true">

					<LinearLayout
						android:id="@+id/header_left"
						android:layout_width="wrap_content"
						android:layout_height="48dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:layout_alignParentTop="true"
						android:layout_alignParentLeft="true">

						<ImageView
							android:id="@+id/img_user_avatar"
							android:layout_width="46dp"
							android:layout_height="46dp"
							android:src="@drawable/ic_profile"
							android:scaleType="centerCrop" />

						<LinearLayout
							android:id="@+id/linear40"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="12dp"
							android:orientation="vertical">

							<TextView
								android:id="@+id/textview62"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Welcome"
								android:textSize="11.5sp"
								android:textColor="#94A3B8" />

							<TextView
								android:id="@+id/text_username"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="R Z"
								android:textSize="14.5sp"
								android:textColor="#FFFFFF" />
						</LinearLayout>
					</LinearLayout>

					<FrameLayout
						android:id="@+id/top_action_pill"
						android:layout_width="wrap_content"
						android:layout_height="42dp"
						android:layout_alignParentRight="true"
						android:layout_alignParentTop="true"
						android:layout_marginTop="3dp"
						android:clipToOutline="true">

						<View
							android:id="@+id/top_action_pill_blur_bg"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:visibility="gone" />

						<LinearLayout
							android:id="@+id/linear82"
							android:layout_width="wrap_content"
							android:layout_height="match_parent"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingLeft="4dp"
							android:paddingRight="4dp">

							<FrameLayout
								android:id="@+id/btn_top_search"
								android:layout_width="38dp"
								android:layout_height="38dp">

								<ImageView
									android:id="@+id/img_top_search"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:layout_gravity="center"
									android:contentDescription="Notifikasi"
									android:src="@drawable/ic_notifications"
									android:scaleType="fitCenter" />
							</FrameLayout>

							<View
								android:id="@+id/top_action_divider"
								android:layout_width="1dp"
								android:layout_height="18dp"
								android:layout_marginLeft="2dp"
								android:layout_marginRight="2dp"
								android:background="#26FFFFFF" />

							<FrameLayout
								android:id="@+id/btn_top_chat"
								android:layout_width="38dp"
								android:layout_height="38dp">

								<ImageView
									android:id="@+id/img_top_chat"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:layout_gravity="center"
									android:contentDescription="Pesan"
									android:src="@drawable/ic_chat"
									android:scaleType="fitCenter" />
							</FrameLayout>
						</LinearLayout>
					</FrameLayout>
				</RelativeLayout>

				<RelativeLayout
					android:id="@+id/relativelayout70"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="14dp"
					android:layout_alignParentBottom="true">

					<LinearLayout
						android:id="@+id/layout_hero_text"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical">

						<TextView
							android:id="@+id/text_hero_title"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Loading..."
							android:textSize="21sp"
							android:textColor="#FFFFFF"
							android:maxLines="1"
							android:singleLine="true"
							android:ellipsize="end" />

						<TextView
							android:id="@+id/text_hero_desc"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="Memuat episode donghua terbaru..."
							android:textSize="12sp"
							android:textColor="#CBD5E1"
							android:maxLines="2"
							android:ellipsize="end" />
					</LinearLayout>

					<RelativeLayout
						android:id="@+id/relativelayout71"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:layout_below="@id/layout_hero_text">

						<LinearLayout
							android:id="@+id/hero_action_group"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_alignParentLeft="true"
							android:layout_centerVertical="true">

							<LinearLayout
								android:id="@+id/btn_hero_play"
								android:layout_width="wrap_content"
								android:layout_height="40dp"
								android:paddingLeft="20dp"
								android:paddingRight="20dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal"
								android:visibility="gone">

								<ImageView
									android:id="@+id/img_play_icon"
									android:layout_width="16dp"
									android:layout_height="16dp"
									android:src="@drawable/ic_play"
									android:scaleType="center" />

								<TextView
									android:id="@+id/text_play_label"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginLeft="8dp"
									android:text="Tonton"
									android:textSize="13.5sp"
									android:textColor="#0F172A" />
							</LinearLayout>

							<FrameLayout
								android:id="@+id/btn_hero_favorite"
								android:layout_width="40dp"
								android:layout_height="40dp"
								android:layout_marginLeft="10dp"
								android:visibility="gone">

								<ImageView
									android:id="@+id/img_hero_favorite"
									android:layout_width="20dp"
									android:layout_height="20dp"
									android:layout_gravity="center"
									android:src="@drawable/ic_favorite"
									android:scaleType="fitCenter" />
							</FrameLayout>
						</LinearLayout>

						<LinearLayout
							android:id="@+id/indicator_capsule"
							android:layout_width="wrap_content"
							android:layout_height="30dp"
							android:paddingLeft="10dp"
							android:paddingRight="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_alignParentRight="true"
							android:layout_centerVertical="true">

							<View
								android:id="@+id/dot_0"
								android:layout_width="16dp"
								android:layout_height="5dp"
								android:background="#FFFFFF" />

							<View
								android:id="@+id/dot_1"
								android:layout_width="5dp"
								android:layout_height="5dp"
								android:layout_marginLeft="5dp"
								android:background="#FFFFFF" />

							<View
								android:id="@+id/dot_2"
								android:layout_width="5dp"
								android:layout_height="5dp"
								android:layout_marginLeft="5dp"
								android:background="#FFFFFF" />
						</LinearLayout>
					</RelativeLayout>
				</RelativeLayout>
			</RelativeLayout>

			<!-- LANJUTKAN MENONTON -->
			<LinearLayout
				android:id="@+id/layout_section_continue"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginTop="6dp"
				android:visibility="gone">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingTop="12dp"
					android:paddingRight="16dp"
					android:paddingBottom="8dp">

					<TextView
						android:id="@+id/text_title_continue"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Lanjutkan Menonton"
						android:textSize="16.5sp"
						android:textColor="#FFFFFF"
						android:layout_alignParentLeft="true"
						android:layout_centerVertical="true" />

					<TextView
						android:id="@+id/text_continue_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Lihat riwayat"
						android:textSize="12.5sp"
						android:textColor="#94A3B8"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerContinue"
					android:layout_width="match_parent"
					android:layout_height="112dp"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:clipToPadding="false"
					android:clipChildren="false" />
			</LinearLayout>

			<!-- POPULER HARI INI -->
			<RelativeLayout
				android:id="@+id/layout_section_popular"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="18dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/text_title_popular"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Populer Hari Ini"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerPopular"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:clipChildren="false"
				android:nestedScrollingEnabled="false" />

			<!-- BARU DIUPDATE -->
			<RelativeLayout
				android:id="@+id/relativelayout72"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="18dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/textview77"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Baru Diupdate"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/text_see_all"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat semua"
					android:textSize="12.5sp"
					android:textColor="#94A3B8"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<GridView
				android:id="@+id/gridview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:paddingBottom="16dp"
				android:numColumns="3"
				android:horizontalSpacing="12dp"
				android:verticalSpacing="16dp"
				android:stretchMode="columnWidth"
				android:nestedScrollingEnabled="false"
				tools:listitem="@layout/custom_anime" />

			<!-- POPULER DI DONGFLIX -->
			<RelativeLayout
				android:id="@+id/layout_section_popular_dongflix"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="18dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/text_title_popular_dongflix"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Populer di Dongflix"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/text_popular_dongflix_see_all"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat semua"
					android:textSize="12.5sp"
					android:textColor="#94A3B8"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerPopularDongflix"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:clipChildren="false"
				android:nestedScrollingEnabled="false" />

			<!-- ROMANTIS TIPIS-TIPIS -->
			<RelativeLayout
				android:id="@+id/layout_section_romance"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="16dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/text_title_romance"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Romantis Tipis-Tipis"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/text_romance_see_all"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat semua"
					android:textSize="12.5sp"
					android:textColor="#94A3B8"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerRomanceDonghua"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:clipChildren="false"
				android:nestedScrollingEnabled="false" />

			<!-- KULTIVASI / ABADI -->
			<RelativeLayout
				android:id="@+id/layout_section_cultivation"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="16dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/text_title_cultivation"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Kultivasi &amp; Keabadian"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/text_cultivation_see_all"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat semua"
					android:textSize="12.5sp"
					android:textColor="#94A3B8"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerCultivationDonghua"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:clipChildren="false"
				android:nestedScrollingEnabled="false" />

			<!-- DONGHUA TAMAT -->
			<RelativeLayout
				android:id="@+id/layout_section_completed"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="16dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/text_title_completed"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Donghua Tamat"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/text_completed_see_all"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat semua"
					android:textSize="12.5sp"
					android:textColor="#94A3B8"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerCompletedDonghua"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:clipChildren="false"
				android:nestedScrollingEnabled="false" />

			<!-- KOMEDI RINGAN -->
			<RelativeLayout
				android:id="@+id/layout_section_comedy"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="16dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/text_title_comedy"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Komedi Ringan"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/text_comedy_see_all"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat semua"
					android:textSize="12.5sp"
					android:textColor="#94A3B8"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerComedyDonghua"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:clipChildren="false"
				android:nestedScrollingEnabled="false" />

			<!-- MISTERI DAN TEKA-TEKI -->
			<RelativeLayout
				android:id="@+id/layout_section_mystery"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="16dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/text_title_mystery"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Misteri &amp; Teka-Teki"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/text_mystery_see_all"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat semua"
					android:textSize="12.5sp"
					android:textColor="#94A3B8"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerMysteryDonghua"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:clipChildren="false"
				android:nestedScrollingEnabled="false" />

			<!-- DONGHUA MOVIE -->
			<RelativeLayout
				android:id="@+id/layout_section_movie"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:paddingLeft="16dp"
				android:paddingTop="16dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp">

				<TextView
					android:id="@+id/text_title_movie"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Donghua Movie"
					android:textSize="16.5sp"
					android:textColor="#FFFFFF"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/text_movie_see_all"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat semua"
					android:textSize="12.5sp"
					android:textColor="#94A3B8"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerMovieDonghua"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="40dp"
				android:clipToPadding="false"
				android:clipChildren="false"
				android:nestedScrollingEnabled="false" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

	<!-- Indikator Icon Refresh Melayang -->
	<FrameLayout
		android:id="@+id/pull_refresh_indicator"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_alignParentTop="true"
		android:layout_centerHorizontal="true"
		android:layout_marginTop="16dp"
