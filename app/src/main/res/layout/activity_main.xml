<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res/auto"
	android:id="@+id/root_main_container"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<!-- HALAMAN BERANDA -->
	<androidx.core.widget.NestedScrollView
		android:id="@+id/main_scroll_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:overScrollMode="never"
		android:paddingBottom="120dp">

		<LinearLayout
			android:id="@+id/home_content_root"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- HERO BANNER + HEADER -->
			<FrameLayout
				android:id="@+id/hero_frame"
				android:layout_width="match_parent"
				android:layout_height="430dp">

				<ImageView
					android:id="@+id/img_hero_banner"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:contentDescription="Hero Banner"
					android:scaleType="centerCrop"
					android:src="@drawable/default_image" />

				<View
					android:id="@+id/header_shadow"
					android:layout_width="match_parent"
					android:layout_height="110dp"
					android:layout_gravity="top" />

				<View
					android:id="@+id/hero_shadow"
					android:layout_width="match_parent"
					android:layout_height="220dp"
					android:layout_gravity="bottom" />

				<RelativeLayout
					android:id="@+id/relativelayout69"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_gravity="top"
					android:paddingLeft="16dp"
					android:paddingTop="8dp"
					android:paddingRight="16dp"
					android:paddingBottom="10dp">

					<LinearLayout
						android:id="@+id/linear_header_user"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:layout_centerVertical="true"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/img_user_avatar"
							android:layout_width="42dp"
							android:layout_height="42dp"
							android:contentDescription="Avatar"
							android:scaleType="centerCrop"
							android:src="@drawable/ic_profile" />

						<LinearLayout
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginStart="10dp"
							android:orientation="vertical">

							<TextView
								android:id="@+id/text_welcome"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Welcome"
								android:textColor="#CBD5E1"
								android:textSize="11.5sp" />

							<TextView
								android:id="@+id/text_username"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="R Z"
								android:textColor="#FFFFFF"
								android:textSize="15sp" />
						</LinearLayout>
					</LinearLayout>

					<LinearLayout
						android:id="@+id/top_header_actions"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:layout_centerVertical="true"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<FrameLayout
							android:id="@+id/btn_top_search"
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:clickable="true"
							android:clipToOutline="true"
							android:focusable="true">

							<eightbitlab.com.blurview.BlurView
								android:id="@+id/top_notif_blur_bg"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								app:blurOverlayColor="#66141824" />

							<ImageView
								android:id="@+id/img_top_search"
								android:layout_width="19dp"
								android:layout_height="19dp"
								android:layout_gravity="center"
								android:contentDescription="Notifikasi"
								android:src="@drawable/ic_notifications" />
						</FrameLayout>

						<FrameLayout
							android:id="@+id/btn_top_chat"
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:layout_marginStart="8dp"
							android:clickable="true"
							android:clipToOutline="true"
							android:focusable="true">

							<eightbitlab.com.blurview.BlurView
								android:id="@+id/top_chat_blur_bg"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								app:blurOverlayColor="#66141824" />

							<ImageView
								android:id="@+id/img_top_chat"
								android:layout_width="19dp"
								android:layout_height="19dp"
								android:layout_gravity="center"
								android:contentDescription="Pesan"
								android:src="@drawable/ic_notifications" />
						</FrameLayout>
					</LinearLayout>
				</RelativeLayout>

				<LinearLayout
					android:id="@+id/hero_bottom_info"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_gravity="bottom"
					android:orientation="vertical"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="18dp">

					<TextView
						android:id="@+id/text_hero_title"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:ellipsize="end"
						android:maxLines="2"
						android:textColor="#FFFFFF"
						android:textSize="24sp" />

					<TextView
						android:id="@+id/text_hero_desc"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:ellipsize="end"
						android:maxLines="2"
						android:textColor="#CBD5E1"
						android:textSize="12.5sp" />

					<RelativeLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp">

						<LinearLayout
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_alignParentStart="true"
							android:layout_centerVertical="true"
							android:gravity="center_vertical"
							android:orientation="horizontal">

							<LinearLayout
								android:id="@+id/btn_hero_play"
								android:layout_width="wrap_content"
								android:layout_height="40dp"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingLeft="18dp"
								android:paddingRight="20dp">

								<ImageView
									android:id="@+id/img_play_icon"
									android:layout_width="16dp"
									android:layout_height="16dp"
									android:src="@drawable/ic_play1"
									app:tint="#000000" />

								<TextView
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginStart="8dp"
									android:text="Tonton"
									android:textColor="#000000"
									android:textSize="13.5sp" />
							</LinearLayout>

							<FrameLayout
								android:id="@+id/btn_hero_favorite"
								android:layout_width="40dp"
								android:layout_height="40dp"
								android:layout_marginStart="10dp"
								android:clipToOutline="true">

								<ImageView
									android:id="@+id/img_hero_favorite"
									android:layout_width="18dp"
									android:layout_height="18dp"
									android:layout_gravity="center"
									android:src="@drawable/ic_bookmark" />
							</FrameLayout>
						</LinearLayout>

						<LinearLayout
							android:id="@+id/indicator_capsule"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_alignParentEnd="true"
							android:layout_centerVertical="true"
							android:gravity="center_vertical"
							android:orientation="horizontal">

							<View
								android:id="@+id/dot_0"
								android:layout_width="16dp"
								android:layout_height="5dp" />

							<View
								android:id="@+id/dot_1"
								android:layout_width="5dp"
								android:layout_height="5dp"
								android:layout_marginStart="5dp" />

							<View
								android:id="@+id/dot_2"
								android:layout_width="5dp"
								android:layout_height="5dp"
								android:layout_marginStart="5dp" />
						</LinearLayout>
					</RelativeLayout>
				</LinearLayout>
			</FrameLayout>

			<!-- LANJUTKAN MENONTON -->
			<LinearLayout
				android:id="@+id/layout_section_continue"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:orientation="vertical"
				android:visibility="gone">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:id="@+id/text_title_continue"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Lanjutkan Menonton"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_continue_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat riwayat"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerContinue"
					android:layout_width="match_parent"
					android:layout_height="132dp"
					android:layout_marginTop="10dp"
					android:clipToPadding="false"
					android:overScrollMode="never"
					android:paddingLeft="16dp"
					android:paddingRight="4dp" />
			</LinearLayout>

			<!-- POPULER HARI INI -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:orientation="vertical">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:text="Populer Hari Ini"
					android:textColor="#FFFFFF"
					android:textSize="16sp" />

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerPopular"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<!-- POPULER DI DONGFLIX -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Populer di Dongflix"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_popular_dongflix_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerPopularDongflix"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<!-- KULTIVASI & KEABADIAN -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Kultivasi &amp; Keabadian"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_cultivation_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerCultivationDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<!-- DONGHUA TAMAT -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Donghua Tamat"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_completed_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerCompletedDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<!-- DONGHUA KOMEDI RINGAN -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Donghua Komedi Ringan"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_comedy_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerComedyDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<!-- MISTERI & TEKA-TEKI -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Misteri &amp; Teka-Teki"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_mystery_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerMysteryDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<!-- DONGHUA MOVIE -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Donghua Movie"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_movie_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerMovieDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<!-- DONGHUA ROMANTIS TIPIS-TIPIS -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Donghua Romantis Tipis-Tipis"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_romance_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerRomanceDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:overScrollMode="never" />
			</LinearLayout>

			<!-- BARU DIUPDATE GRID -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentStart="true"
						android:text="Baru Diupdate"
						android:textColor="#FFFFFF"
						android:textSize="16sp" />

					<TextView
						android:id="@+id/text_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentEnd="true"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="13sp" />
				</RelativeLayout>

				<GridView
					android:id="@+id/gridview1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:horizontalSpacing="12dp"
					android:numColumns="3"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:stretchMode="columnWidth"
					android:verticalSpacing="16dp" />
			</LinearLayout>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

	<!-- HALAMAN PUSTAKA -->
	<FrameLayout
		android:id="@+id/layout_favorite"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:visibility="gone" />

	<!-- HALAMAN AKUN -->
	<FrameLayout
		android:id="@+id/layout_profile"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:visibility="gone" />

	<!-- HALAMAN PENCARIAN -->
	<LinearLayout
		android:id="@+id/layout_search"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:orientation="vertical"
		android:visibility="gone">

		<LinearLayout
			android:id="@+id/search_bar_container"
			android:layout_width="match_parent"
			android:layout_height="46dp"
			android:layout_marginLeft="16dp"
			android:layout_marginRight="16dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingLeft="14dp"
			android:paddingRight="12dp">

			<ImageView
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:src="@drawable/ic_search"
				app:tint="#94A3B8" />

			<EditText
				android:id="@+id/input_search"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_marginStart="10dp"
				android:layout_weight="1"
				android:background="@android:color/transparent"
				android:hint="Cari judul donghua atau genre..."
				android:imeOptions="actionSearch"
				android:singleLine="true"
				android:textColor="#FFFFFF"
				android:textColorHint="#64748B"
				android:textSize="13.5sp" />

			<TextView
				android:id="@+id/btn_clear_search"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:gravity="center"
				android:text="✕"
				android:textColor="#CBD5E1"
				android:textSize="11sp"
				android:visibility="gone" />
		</LinearLayout>

		<TextView
			android:id="@+id/text_search_section_label"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:layout_marginTop="14dp"
			android:layout_marginBottom="8dp"
			android:text="Populer di Dongflix"
			android:textColor="#94A3B8"
			android:textSize="13sp" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler_search_list"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:clipToPadding="false"
			android:paddingBottom="120dp" />
	</LinearLayout>

	<!-- PULL TO REFRESH INDICATOR -->
	<FrameLayout
		android:id="@+id/pull_refresh_indicator"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_gravity="top|center_horizontal"
		android:layout_marginTop="74dp"
		android:visibility="gone">

		<ImageView
			android:id="@+id/img_pull_refresh_icon"
			android:layout_width="18dp"
			android:layout_height="18dp"
			android:layout_gravity="center"
			android:src="@drawable/ic_chevron_down" />

		<ProgressBar
			android:id="@+id/pull_refresh_spinner"
			android:layout_width="22dp"
			android:layout_height="22dp"
			android:layout_gravity="center"
			android:indeterminate="true"
			android:visibility="gone" />
	</FrameLayout>

	<!-- MINI PLAYER INLINE SLOT -->
	<FrameLayout
		android:id="@+id/mini_player_inline_slot"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:layout_marginBottom="86dp"
		android:visibility="gone" />

	<!-- COMPACT HOME BUTTON -->
	<FrameLayout
		android:id="@+id/btn_compact_home"
		android:layout_width="54dp"
		android:layout_height="54dp"
		android:layout_gravity="bottom|start"
		android:layout_marginLeft="16dp"
		android:layout_marginBottom="18dp"
		android:clipToOutline="true"
		android:visibility="gone">

		<eightbitlab.com.blurview.BlurView
			android:id="@+id/compact_home_blur_bg"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:blurOverlayColor="#66141824" />

		<ImageView
			android:layout_width="22dp"
			android:layout_height="22dp"
			android:layout_gravity="center"
			android:src="@drawable/ic_home"
			app:tint="#FFFFFF" />
	</FrameLayout>

	<!-- BOTTOM NAVBAR + SEARCH BUTTON -->
	<RelativeLayout
		android:id="@+id/navbar_wrapper"
		android:layout_width="match_parent"
		android:layout_height="64dp"
		android:layout_gravity="bottom"
		android:layout_marginLeft="16dp"
		android:layout_marginRight="16dp"
		android:layout_marginBottom="16dp">

		<FrameLayout
			android:id="@+id/navbar"
			android:layout_width="0dp"
			android:layout_height="64dp"
			android:layout_alignParentStart="true"
			android:layout_marginEnd="10dp"
			android:layout_toStartOf="@id/btn_circle_search"
			android:clipToOutline="true">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/navbar_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="horizontal"
				android:padding="5dp">

				<LinearLayout
					android:id="@+id/tab_beranda"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="vertical">

					<ImageView
						android:id="@+id/img_home"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/ic_home" />

					<TextView
						android:id="@+id/txt_home"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="Beranda"
						android:textColor="#FFFFFF"
						android:textSize="11sp" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/tab_pustaka"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="vertical">

					<ImageView
						android:id="@+id/img_favorite"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/ic_bookmark" />

					<TextView
						android:id="@+id/txt_favorite"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="Pustaka"
						android:textColor="#94A3B8"
						android:textSize="11sp" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/tab_akun"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="vertical">

					<ImageView
						android:id="@+id/img_profile"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/ic_profile" />

					<TextView
						android:id="@+id/txt_profile"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="Akun"
						android:textColor="#94A3B8"
						android:textSize="11sp" />
				</LinearLayout>
			</LinearLayout>
		</FrameLayout>

		<FrameLayout
			android:id="@+id/btn_circle_search"
			android:layout_width="64dp"
			android:layout_height="64dp"
			android:layout_alignParentEnd="true"
			android:clickable="true"
			android:clipToOutline="true"
			android:focusable="true">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/search_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<ImageView
				android:id="@+id/img_search"
				android:layout_width="22dp"
				android:layout_height="22dp"
				android:layout_gravity="center"
				android:src="@drawable/ic_search" />
		</FrameLayout>
	</RelativeLayout>

</FrameLayout>
