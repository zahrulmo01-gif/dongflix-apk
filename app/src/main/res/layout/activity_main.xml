<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/root_main_container"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<!-- Halaman Utama -->
	<androidx.core.widget.NestedScrollView
		android:id="@+id/main_scroll_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:paddingBottom="118dp"
		android:scrollbars="none">

		<LinearLayout
			android:id="@+id/main_content_column"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- Banner Tarik ke Atas untuk Refresh -->
			<LinearLayout
				android:id="@+id/pull_refresh_banner"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:orientation="horizontal"
				android:paddingTop="56dp"
				android:paddingBottom="8dp"
				android:visibility="gone">

				<ProgressBar
					android:id="@+id/pull_refresh_progress"
					android:layout_width="18dp"
					android:layout_height="18dp"
					android:layout_marginEnd="8dp"
					android:indeterminateTint="#38BDF8" />

				<TextView
					android:id="@+id/pull_refresh_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Tarik ke bawah untuk memperbarui"
					android:textColor="#CBD5E1"
					android:textSize="12.5sp"
					android:textStyle="bold" />
			</LinearLayout>

			<!-- Hero Banner -->
			<FrameLayout
				android:id="@+id/hero_container"
				android:layout_width="match_parent"
				android:layout_height="430dp">

				<ImageView
					android:id="@+id/img_hero_banner"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:scaleType="centerCrop" />

				<View
					android:id="@+id/hero_shadow"
					android:layout_width="match_parent"
					android:layout_height="190dp"
					android:layout_gravity="bottom" />

				<LinearLayout
					android:id="@+id/hero_info_box"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_gravity="bottom"
					android:orientation="vertical"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="14dp">

					<TextView
						android:id="@+id/text_hero_title"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:ellipsize="end"
						android:lineSpacingExtra="2dp"
						android:maxLines="2"
						android:textColor="#FFFFFF"
						android:textSize="22sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/text_hero_desc"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:ellipsize="end"
						android:lineSpacingMultiplier="1.15"
						android:maxLines="2"
						android:textColor="#CBD5E1"
						android:textSize="12.5sp" />

					<LinearLayout
						android:id="@+id/hero_action_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<LinearLayout
							android:id="@+id/btn_hero_play"
							android:layout_width="wrap_content"
							android:layout_height="42dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingLeft="20dp"
							android:paddingRight="22dp">

							<ImageView
								android:id="@+id/img_play_icon"
								android:layout_width="16dp"
								android:layout_height="16dp"
								android:layout_marginEnd="8dp"
								android:src="@drawable/ic_play1"
								android:tint="#000000" />

							<TextView
								android:id="@+id/text_hero_play"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Tonton"
								android:textColor="#000000"
								android:textSize="13.5sp"
								android:textStyle="bold" />
						</LinearLayout>

						<FrameLayout
							android:id="@+id/btn_hero_favorite"
							android:layout_width="42dp"
							android:layout_height="42dp"
							android:layout_marginStart="10dp">

							<ImageView
								android:id="@+id/img_hero_favorite"
								android:layout_width="20dp"
								android:layout_height="20dp"
								android:layout_gravity="center"
								android:src="@drawable/ic_bookmark" />
						</FrameLayout>

						<View
							android:layout_width="0dp"
							android:layout_height="1dp"
							android:layout_weight="1" />

						<LinearLayout
							android:id="@+id/indicator_capsule"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">

							<View
								android:id="@+id/dot_0"
								android:layout_width="16dp"
								android:layout_height="5dp" />

							<View
								android:id="@+id/dot_1"
								android:layout_width="5dp"
								android:layout_height="5dp"
								android:layout_marginStart="5dp" />

							<View
								android:id="@+id/dot_2"
								android:layout_width="5dp"
								android:layout_height="5dp"
								android:layout_marginStart="5dp" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>

			<!-- Lanjutkan Menonton -->
			<LinearLayout
				android:id="@+id/layout_section_continue"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:orientation="vertical"
				android:visibility="gone">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="10dp">

					<TextView
						android:id="@+id/text_title_continue"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Lanjutkan Menonton"
						android:textColor="#FFFFFF"
						android:textSize="17sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/text_continue_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerContinue"
					android:layout_width="match_parent"
					android:layout_height="132dp"
					android:clipToPadding="false"
					android:nestedScrollingEnabled="false"
					android:paddingLeft="16dp"
					android:paddingRight="16dp" />
			</LinearLayout>

			<!-- Populer Hari Ini -->
			<LinearLayout
				android:id="@+id/layout_section_popular_today"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:orientation="vertical">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="12dp">

					<TextView
						android:id="@+id/text_title_popular_today"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Populer Hari Ini"
						android:textColor="#FFFFFF"
						android:textSize="17sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/text_see_all"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Lihat semua"
						android:textColor="#94A3B8"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerPopular"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:clipToPadding="false"
					android:nestedScrollingEnabled="false"
					android:paddingLeft="16dp"
					android:paddingRight="16dp" />
			</LinearLayout>

			<!-- Donghua Terbaru -->
			<LinearLayout
				android:id="@+id/layout_section_latest"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:orientation="vertical">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="12dp">

					<TextView
						android:id="@+id/text_title_latest"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Baru Diupdate"
						android:textColor="#FFFFFF"
						android:textSize="17sp"
						android:textStyle="bold" />
				</LinearLayout>

				<GridView
					android:id="@+id/gridview1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:horizontalSpacing="12dp"
					android:nestedScrollingEnabled="false"
					android:numColumns="3"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:stretchMode="columnWidth"
					android:verticalSpacing="16dp" />
			</LinearLayout>

			<!-- Donghua Movie -->
			<LinearLayout
				android:id="@+id/layout_section_movie"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:orientation="vertical">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="12dp">

					<TextView
						android:id="@+id/text_title_movie"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Donghua Movie"
						android:textColor="#FFFFFF"
						android:textSize="17sp"
						android:textStyle="bold" />
				</LinearLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerMovieDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:clipToPadding="false"
					android:nestedScrollingEnabled="false"
					android:paddingLeft="16dp"
					android:paddingRight="16dp" />
			</LinearLayout>

			<!-- Donghua Tamat -->
			<LinearLayout
				android:id="@+id/layout_section_completed"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:orientation="vertical">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="12dp">

					<TextView
						android:id="@+id/text_title_completed"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Donghua Tamat"
						android:textColor="#FFFFFF"
						android:textSize="17sp"
						android:textStyle="bold" />
				</LinearLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerCompletedDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:clipToPadding="false"
					android:nestedScrollingEnabled="false"
					android:paddingLeft="16dp"
					android:paddingRight="16dp" />
			</LinearLayout>

			<!-- Donghua Komedi Ringan -->
			<LinearLayout
				android:id="@+id/layout_section_comedy"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:orientation="vertical">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="12dp">

					<TextView
						android:id="@+id/text_title_comedy"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Donghua Komedi Ringan"
						android:textColor="#FFFFFF"
						android:textSize="17sp"
						android:textStyle="bold" />
				</LinearLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerComedyDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:clipToPadding="false"
					android:nestedScrollingEnabled="false"
					android:paddingLeft="16dp"
					android:paddingRight="16dp" />
			</LinearLayout>

			<!-- Misteri dan Teka-Teki -->
			<LinearLayout
				android:id="@+id/layout_section_mystery"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:orientation="vertical">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="12dp">

					<TextView
						android:id="@+id/text_title_mystery"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Misteri dan Teka-Teki"
						android:textColor="#FFFFFF"
						android:textSize="17sp"
						android:textStyle="bold" />
				</LinearLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerMysteryDonghua"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:clipToPadding="false"
					android:nestedScrollingEnabled="false"
					android:paddingLeft="16dp"
					android:paddingRight="16dp" />
			</LinearLayout>

			<!-- Populer Horizontal (2 Poster Penuh + 1 Mengintip) -->
			<LinearLayout
				android:id="@+id/layout_section_popular_all"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:orientation="vertical">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:paddingBottom="12dp">

					<TextView
						android:id="@+id/text_title_popular_all"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Populer"
						android:textColor="#FFFFFF"
						android:textSize="17sp"
						android:textStyle="bold" />
				</LinearLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/listPopular"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:clipToPadding="false"
					android:nestedScrollingEnabled="false"
					android:paddingLeft="16dp"
					android:paddingRight="16dp" />
			</LinearLayout>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

	<!-- Top Gradient & Header -->
	<View
		android:id="@+id/header_shadow"
		android:layout_width="match_parent"
		android:layout_height="92dp"
		android:layout_gravity="top" />

	<RelativeLayout
		android:id="@+id/relativelayout69"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:paddingLeft="16dp"
		android:paddingTop="12dp"
		android:paddingRight="16dp"
		android:paddingBottom="10dp">

		<LinearLayout
			android:id="@+id/header_user_box"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentStart="true"
			android:layout_centerVertical="true"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageView
				android:id="@+id/img_user_avatar"
				android:layout_width="38dp"
				android:layout_height="38dp"
				android:scaleType="centerCrop"
				android:src="@drawable/ic_profile" />

			<TextView
				android:id="@+id/text_username"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="10dp"
				android:textColor="#FFFFFF"
				android:textSize="15sp"
				android:textStyle="bold" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/header_actions_box"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentEnd="true"
			android:layout_centerVertical="true"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<FrameLayout
				android:id="@+id/btn_top_search"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginEnd="8dp">

				<ImageView
					android:id="@+id/img_top_search"
					android:layout_width="19dp"
					android:layout_height="19dp"
					android:layout_gravity="center"
					android:src="@drawable/ic_search" />
			</FrameLayout>

			<FrameLayout
				android:id="@+id/btn_top_chat"
				android:layout_width="40dp"
				android:layout_height="40dp">

				<ImageView
					android:id="@+id/img_top_chat"
					android:layout_width="19dp"
					android:layout_height="19dp"
					android:layout_gravity="center"
					android:src="@drawable/ic_chat" />
			</FrameLayout>
		</LinearLayout>
	</RelativeLayout>

	<!-- Halaman Pencarian -->
	<LinearLayout
		android:id="@+id/layout_search"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:orientation="vertical"
		android:visibility="gone">

		<LinearLayout
			android:id="@+id/search_bar_container"
			android:layout_width="match_parent"
			android:layout_height="48dp"
			android:layout_marginLeft="16dp"
			android:layout_marginTop="16dp"
			android:layout_marginRight="16dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingLeft="16dp"
			android:paddingRight="10dp">

			<EditText
				android:id="@+id/input_search"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:background="@android:color/transparent"
				android:hint="Cari donghua..."
				android:inputType="text"
				android:singleLine="true"
				android:textColor="#FFFFFF"
				android:textColorHint="#64748B"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/btn_clear_search"
				android:layout_width="28dp"
				android:layout_height="28dp"
				android:gravity="center"
				android:text="✕"
				android:textColor="#CBD5E1"
				android:textSize="12sp"
				android:visibility="gone" />
		</LinearLayout>

		<TextView
			android:id="@+id/text_search_section_label"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:layout_marginTop="16dp"
			android:layout_marginBottom="10dp"
			android:text="Populer"
			android:textColor="#FFFFFF"
			android:textSize="17sp"
			android:textStyle="bold" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler_search_list"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:paddingBottom="110dp" />
	</LinearLayout>

	<!-- Halaman Pustaka -->
	<FrameLayout
		android:id="@+id/layout_favorite"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:visibility="gone" />

	<!-- Halaman Akun -->
	<LinearLayout
		android:id="@+id/layout_profile"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:gravity="center"
		android:orientation="vertical"
		android:padding="24dp"
		android:visibility="gone">

		<TextView
			android:id="@+id/textview65"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Akun"
			android:textColor="#FFFFFF"
			android:textSize="20sp"
			android:textStyle="bold" />
	</LinearLayout>

	<!-- Bottom Navbar & Mini Player Slot -->
	<LinearLayout
		android:id="@+id/navbar_wrapper"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:orientation="vertical"
		android:paddingLeft="14dp"
		android:paddingRight="14dp"
		android:paddingBottom="14dp">

		<FrameLayout
			android:id="@+id/mini_player_inline_slot"
			android:layout_width="match_parent"
			android:layout_height="60dp"
			android:layout_marginBottom="8dp"
			android:visibility="gone" />

		<LinearLayout
			android:id="@+id/navbar_row"
			android:layout_width="match_parent"
			android:layout_height="64dp"
			android:clipChildren="false"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<FrameLayout
				android:id="@+id/btn_compact_home"
				android:layout_width="56dp"
				android:layout_height="56dp"
				android:layout_marginEnd="10dp"
				android:visibility="gone">

				<eightbitlab.com.blurview.BlurView
					android:id="@+id/compact_home_blur_bg"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					app:blurOverlayColor="#66141824" />

				<ImageView
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:layout_gravity="center"
					android:src="@drawable/ic_home"
					android:tint="#FFFFFF" />
			</FrameLayout>

			<FrameLayout
				android:id="@+id/navbar"
				android:layout_width="0dp"
				android:layout_height="64dp"
				android:layout_weight="1">

				<eightbitlab.com.blurview.BlurView
					android:id="@+id/navbar_blur_bg"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					app:blurOverlayColor="#66141824" />

				<LinearLayout
					android:id="@+id/navbar_tabs_row"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:baselineAligned="false"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingLeft="5dp"
					android:paddingRight="5dp">

					<LinearLayout
						android:id="@+id/tab_beranda"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:gravity="center"
						android:orientation="vertical">

						<ImageView
							android:id="@+id/img_home"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:src="@drawable/ic_home" />

						<TextView
							android:id="@+id/txt_home"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="Beranda"
							android:textColor="#FFFFFF"
							android:textSize="11sp"
							android:textStyle="bold" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/tab_pustaka"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:gravity="center"
						android:orientation="vertical">

						<ImageView
							android:id="@+id/img_favorite"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:src="@drawable/ic_bookmark" />

						<TextView
							android:id="@+id/txt_favorite"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="Pustaka"
							android:textColor="#94A3B8"
							android:textSize="11sp"
							android:textStyle="bold" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/tab_akun"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:gravity="center"
						android:orientation="vertical">

						<ImageView
							android:id="@+id/img_profile"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:src="@drawable/ic_profile" />

						<TextView
							android:id="@+id/txt_profile"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="Akun"
							android:textColor="#94A3B8"
							android:textSize="11sp"
							android:textStyle="bold" />
					</LinearLayout>
				</LinearLayout>
			</FrameLayout>

			<FrameLayout
				android:id="@+id/btn_circle_search"
				android:layout_width="56dp"
				android:layout_height="56dp"
				android:layout_marginStart="10dp">

				<eightbitlab.com.blurview.BlurView
					android:id="@+id/search_blur_bg"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					app:blurOverlayColor="#66141824" />

				<ImageView
					android:id="@+id/img_search"
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:layout_gravity="center"
					android:src="@drawable/ic_search" />
			</FrameLayout>
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
