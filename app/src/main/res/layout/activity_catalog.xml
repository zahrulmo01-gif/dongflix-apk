<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/catalog_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/catalog_scroll_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:paddingTop="120dp"
		android:paddingBottom="110dp"
		android:scrollbars="none">

		<LinearLayout
			android:id="@+id/catalog_content_column"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingTop="6dp"
			android:paddingBottom="32dp">

			<!-- Baris Filter: Filter, Semua, Donghua -->
			<HorizontalScrollView
				android:id="@+id/catalog_filter_scroll"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:clipToPadding="false"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:scrollbars="none">

				<LinearLayout
					android:id="@+id/catalog_filter_container"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:id="@+id/filter_menu"
						android:layout_width="wrap_content"
						android:layout_height="36dp"
						android:layout_marginEnd="8dp"
						android:gravity="center"
						android:paddingLeft="16dp"
						android:paddingRight="16dp"
						android:text="Filter"
						android:textColor="#CBD5E1"
						android:textSize="13sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/filter_semua"
						android:layout_width="wrap_content"
						android:layout_height="36dp"
						android:layout_marginEnd="8dp"
						android:gravity="center"
						android:paddingLeft="18dp"
						android:paddingRight="18dp"
						android:text="Semua"
						android:textColor="#FFFFFF"
						android:textSize="13sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/filter_donghua"
						android:layout_width="wrap_content"
						android:layout_height="36dp"
						android:gravity="center"
						android:paddingLeft="18dp"
						android:paddingRight="18dp"
						android:text="Donghua"
						android:textColor="#CBD5E1"
						android:textSize="13sp"
						android:textStyle="bold" />
				</LinearLayout>
			</HorizontalScrollView>

			<GridView
				android:id="@+id/grid_catalog"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:horizontalSpacing="12dp"
				android:nestedScrollingEnabled="false"
				android:numColumns="3"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:stretchMode="columnWidth"
				android:verticalSpacing="16dp" />

			<!-- Indikator Ringan Saat Memuat Halaman Berikutnya -->
			<LinearLayout
				android:id="@+id/layout_loading_more"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:layout_marginTop="14dp"
				android:gravity="center"
				android:orientation="horizontal"
				android:visibility="gone">

				<ProgressBar
					android:id="@+id/progress_load_more"
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:layout_marginEnd="8dp"
					android:indeterminateTint="#38BDF8" />

				<TextView
					android:id="@+id/text_load_more_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Memuat lainnya..."
					android:textColor="#94A3B8"
					android:textSize="12.5sp"
					android:textStyle="bold" />
			</LinearLayout>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

	<!-- Header Floating Blur (Judul Kiri + Terbaru di Bawahnya) -->
	<LinearLayout
		android:id="@+id/catalog_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingLeft="14dp"
		android:paddingTop="12dp"
		android:paddingRight="14dp"
		android:paddingBottom="10dp">

		<FrameLayout
			android:id="@+id/btn_catalog_back"
			android:layout_width="42dp"
			android:layout_height="42dp"
			android:layout_marginEnd="10dp">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/catalog_back_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<ImageView
				android:id="@+id/img_catalog_back_arrow"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_gravity="center"
				android:contentDescription="Kembali"
				android:scaleType="fitCenter"
				android:src="@drawable/ic_back_arrow" />
		</FrameLayout>

		<FrameLayout
			android:id="@+id/catalog_header_pill"
			android:layout_width="0dp"
			android:layout_height="52dp"
			android:layout_weight="1">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/catalog_header_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<LinearLayout
				android:id="@+id/catalog_header_titles"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_vertical|start"
				android:orientation="vertical"
				android:paddingLeft="16dp"
				android:paddingRight="16dp">

				<TextView
					android:id="@+id/text_catalog_title"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Katalog Donghua"
					android:textColor="#FFFFFF"
					android:textSize="15sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/text_catalog_subtitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Terbaru"
					android:textColor="#94A3B8"
					android:textSize="11sp"
					android:textStyle="bold" />
			</LinearLayout>
		</FrameLayout>
	</LinearLayout>

	<!-- Tombol OnTop di Kanan Bawah -->
	<FrameLayout
		android:id="@+id/btn_scroll_top"
		android:layout_width="46dp"
		android:layout_height="46dp"
		android:layout_gravity="bottom|end"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="28dp"
		android:alpha="0f"
		android:visibility="gone">

		<eightbitlab.com.blurview.BlurView
			android:id="@+id/scroll_top_blur_bg"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:blurOverlayColor="#66141824" />

		<ImageView
			android:id="@+id/img_scroll_top_arrow"
			android:layout_width="18dp"
			android:layout_height="18dp"
			android:layout_gravity="center"
			android:contentDescription="Kembali ke Atas"
			android:rotation="90"
			android:scaleType="fitCenter"
			android:src="@drawable/ic_back_arrow" />
	</FrameLayout>
</FrameLayout>
