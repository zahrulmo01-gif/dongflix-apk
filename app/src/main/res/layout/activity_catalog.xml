<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/catalog_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/catalog_scroll_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:paddingTop="74dp"
		android:paddingBottom="110dp"
		android:scrollbars="none">

		<LinearLayout
			android:id="@+id/catalog_content_column"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingTop="8dp"
			android:paddingBottom="28dp">

			<GridView
				android:id="@+id/grid_catalog"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:horizontalSpacing="12dp"
				android:nestedScrollingEnabled="false"
				android:numColumns="3"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:stretchMode="columnWidth"
				android:verticalSpacing="16dp" />

			<TextView
				android:id="@+id/btn_load_more"
				android:layout_width="match_parent"
				android:layout_height="46dp"
				android:layout_marginLeft="16dp"
				android:layout_marginTop="20dp"
				android:layout_marginRight="16dp"
				android:layout_marginBottom="16dp"
				android:gravity="center"
				android:text="Muat Lainnya"
				android:textColor="#FFFFFF"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

	<!-- Header Floating Blur (Seragam dengan Live Chat) -->
	<LinearLayout
		android:id="@+id/catalog_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingLeft="14dp"
		android:paddingTop="12dp"
		android:paddingRight="14dp"
		android:paddingBottom="10dp">

		<FrameLayout
			android:id="@+id/btn_catalog_back"
			android:layout_width="42dp"
			android:layout_height="42dp"
			android:layout_marginEnd="10dp">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/catalog_back_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<ImageView
				android:id="@+id/img_catalog_back_arrow"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_gravity="center"
				android:contentDescription="Kembali"
				android:scaleType="fitCenter"
				android:src="@drawable/ic_back_arrow" />
		</FrameLayout>

		<FrameLayout
			android:id="@+id/catalog_header_pill"
			android:layout_width="0dp"
			android:layout_height="46dp"
			android:layout_weight="1">

			<eightbitlab.com.blurview.BlurView
				android:id="@+id/catalog_header_blur_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				app:blurOverlayColor="#66141824" />

			<TextView
				android:id="@+id/text_catalog_title"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:text="Katalog Donghua"
				android:textColor="#FFFFFF"
				android:textSize="15sp"
				android:textStyle="bold" />
		</FrameLayout>
	</LinearLayout>
</FrameLayout>
