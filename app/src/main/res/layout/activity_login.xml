<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/root_login_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:overScrollMode="never">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="24dp"
			android:paddingTop="48dp"
			android:paddingRight="24dp"
			android:paddingBottom="36dp"
			android:gravity="center_vertical"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<FrameLayout
					android:id="@+id/logo_badge_box"
					android:layout_width="46dp"
					android:layout_height="46dp">

					<ImageView
						android:layout_width="22dp"
						android:layout_height="22dp"
						android:layout_gravity="center"
						android:src="@drawable/ic_play1"
						android:scaleType="fitCenter" />
				</FrameLayout>

				<TextView
					android:id="@+id/text_brand_name"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="12dp"
					android:text="Dongflix"
					android:textSize="24sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
			</LinearLayout>

			<TextView
				android:id="@+id/text_auth_heading"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="28dp"
				android:text="Selamat Datang Kembali"
				android:textSize="26sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />

			<TextView
				android:id="@+id/text_auth_sub"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="Masuk menggunakan email dan password akun Dongflix kamu."
				android:textSize="13.5sp"
				android:textColor="#94A3B8" />

			<LinearLayout
				android:id="@+id/tab_switch_container"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:layout_marginTop="26dp"
				android:padding="4dp"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/tab_mode_login"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center"
					android:text="Masuk"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />

				<TextView
					android:id="@+id/tab_mode_register"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center"
					android:text="Daftar Baru"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="#94A3B8" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/auth_form_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:padding="20dp"
				android:orientation="vertical">

				<LinearLayout
					android:id="@+id/group_register_fields"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:visibility="gone">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Nama Tampilan"
						android:textSize="12.5sp"
						android:textStyle="bold"
						android:textColor="#CBD5E1" />

					<EditText
						android:id="@+id/input_reg_name"
						android:layout_width="match_parent"
						android:layout_height="48dp"
						android:layout_marginTop="8dp"
						android:paddingLeft="16dp"
						android:paddingRight="16dp"
						android:textSize="14sp"
						android:textColor="#FFFFFF"
						android:hint="Contoh: RZ"
						android:textColorHint="#64748B"
						android:inputType="textPersonName"
						android:singleLine="true" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						android:text="Username"
						android:textSize="12.5sp"
						android:textStyle="bold"
						android:textColor="#CBD5E1" />

					<EditText
						android:id="@+id/input_reg_username"
						android:layout_width="match_parent"
						android:layout_height="48dp"
						android:layout_marginTop="8dp"
						android:layout_marginBottom="16dp"
						android:paddingLeft="16dp"
						android:paddingRight="16dp"
						android:textSize="14sp"
						android:textColor="#FFFFFF"
						android:hint="Contoh: dongflix"
						android:textColorHint="#64748B"
						android:inputType="textNoSuggestions"
						android:singleLine="true" />
				</LinearLayout>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Alamat Email"
					android:textSize="12.5sp"
					android:textStyle="bold"
					android:textColor="#CBD5E1" />

				<EditText
					android:id="@+id/input_auth_email"
					android:layout_width="match_parent"
					android:layout_height="48dp"
					android:layout_marginTop="8dp"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:textSize="14sp"
					android:textColor="#FFFFFF"
					android:hint="nama@gmail.com"
					android:textColorHint="#64748B"
					android:inputType="textEmailAddress"
					android:singleLine="true" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:text="Password"
					android:textSize="12.5sp"
					android:textStyle="bold"
					android:textColor="#CBD5E1" />

				<EditText
					android:id="@+id/input_auth_password"
					android:layout_width="match_parent"
					android:layout_height="48dp"
					android:layout_marginTop="8dp"
					android:paddingLeft="16dp"
					android:paddingRight="16dp"
					android:textSize="14sp"
					android:textColor="#FFFFFF"
					android:hint="Minimal 6 karakter"
					android:textColorHint="#64748B"
					android:inputType="textPassword"
					android:singleLine="true" />

				<FrameLayout
					android:id="@+id/btn_submit_auth"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:layout_marginTop="24dp">

					<TextView
						android:id="@+id/text_submit_auth"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="center"
						android:text="Masuk Sekarang"
						android:textSize="15sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />

					<ProgressBar
						android:id="@+id/progress_auth"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:layout_gravity="center"
						android:indeterminate="true"
						android:indeterminateTint="#FFFFFF"
						android:visibility="gone" />
				</FrameLayout>
			</LinearLayout>

			<TextView
				android:id="@+id/text_toggle_hint"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:layout_marginTop="20dp"
				android:text="Belum punya akun? Daftar di sini"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="#3B82F6" />

		</LinearLayout>
	</ScrollView>
</RelativeLayout>
