<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#0D0D10"
	android:fitsSystemWindows="true"
	android:orientation="vertical">

	<FrameLayout
		android:id="@+id/layoutPlayer"
		android:layout_width="match_parent"
		android:layout_height="220dp"
		android:background="#000000">

		<android.view.TextureView
			android:id="@+id/playerTextureView"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<RelativeLayout
			android:id="@+id/playerControlsOverlay"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@android:color/transparent">

			<View
				android:id="@+id/gradientTop"
				android:layout_width="match_parent"
				android:layout_height="70dp"
				android:clickable="false"
				android:focusable="false"
				android:layout_alignParentTop="true" />

			<View
				android:id="@+id/gradientBottom"
				android:layout_width="match_parent"
				android:layout_height="80dp"
				android:clickable="false"
				android:focusable="false"
				android:layout_alignParentBottom="true" />

			<RelativeLayout
				android:id="@+id/topBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingTop="12dp"
				android:paddingRight="16dp"
				android:layout_alignParentTop="true">

				<ImageView
					android:id="@+id/btnBack"
					android:layout_width="28dp"
					android:layout_height="28dp"
					android:padding="2dp"
					android:src="@drawable/ic_back_arrow"
					android:scaleType="centerInside"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/textPlayerTitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="14dp"
					android:layout_marginRight="14dp"
					android:text="Judul Donghua"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:maxLines="1"
					android:ellipsize="end"
					android:visibility="gone"
					android:layout_toLeftOf="@id/topRightControls"
					android:layout_toRightOf="@id/btnBack"
					android:layout_centerVertical="true" />

				<LinearLayout
					android:id="@+id/topRightControls"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true">

					<LinearLayout
						android:id="@+id/btnFill"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginRight="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageview4"
							android:layout_width="18dp"
							android:layout_height="18dp"
							android:src="@drawable/ic_fill"
							android:scaleType="centerInside" />

						<TextView
							android:id="@+id/textview4"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="5dp"
							android:text="Fill"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>

					<TextView
						android:id="@+id/btnSpeed"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="4dp"
						android:text="1x"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
				</LinearLayout>
			</RelativeLayout>

			<LinearLayout
				android:id="@+id/centerControls"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:orientation="horizontal"
				android:layout_centerInParent="true">

				<ImageView
					android:id="@+id/btnPrevEpisode"
					android:layout_width="30dp"
					android:layout_height="30dp"
					android:padding="3dp"
					android:src="@drawable/ic_prev"
					android:scaleType="fitCenter" />

				<ImageView
					android:id="@+id/btnRewind"
					android:layout_width="38dp"
					android:layout_height="38dp"
					android:layout_marginLeft="18dp"
					android:padding="6dp"
					android:src="@drawable/ic_rewind"
					android:scaleType="fitCenter" />

				<FrameLayout
					android:id="@+id/frame_layout5"
					android:layout_width="82dp"
					android:layout_height="82dp"
					android:layout_marginLeft="18dp"
					android:layout_marginRight="18dp">

					<ProgressBar
						android:id="@+id/playerLoading"
						android:layout_width="76dp"
						android:layout_height="76dp"
						android:indeterminate="true"
						android:indeterminateTint="#FFFFFF"
						android:layout_gravity="center"
						android:visibility="gone" />

					<ImageView
						android:id="@+id/btnPlay"
						android:layout_width="60dp"
						android:layout_height="60dp"
						android:padding="16dp"
						android:src="@drawable/ic_play1"
						android:scaleType="fitCenter"
						android:layout_gravity="center" />
				</FrameLayout>

				<ImageView
					android:id="@+id/btnForward"
					android:layout_width="38dp"
					android:layout_height="38dp"
					android:layout_marginRight="18dp"
					android:padding="6dp"
					android:src="@drawable/ic_forward"
					android:scaleType="fitCenter" />

				<ImageView
					android:id="@+id/btnNextEpisode"
					android:layout_width="30dp"
					android:layout_height="30dp"
					android:padding="3dp"
					android:src="@drawable/ic_next"
					android:scaleType="fitCenter" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/bottomControls"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="6dp"
				android:orientation="vertical"
				android:layout_alignParentBottom="true">

				<RelativeLayout
					android:id="@+id/relativelayout2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="4dp"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:id="@+id/textTime"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="00:00 / 00:00"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:layout_alignParentLeft="true"
						android:layout_centerVertical="true" />

					<LinearLayout
						android:id="@+id/linear2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true">

						<TextView
							android:id="@+id/btnQuality"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="4dp"
							android:text="Auto"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />

						<ImageView
							android:id="@+id/btnFullscreen"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:layout_marginLeft="10dp"
							android:padding="2dp"
							android:src="@drawable/ic_fullscreen"
							android:scaleType="centerInside" />
					</LinearLayout>
				</RelativeLayout>

				<SeekBar
					android:id="@+id/playerSeekBar"
					android:layout_width="match_parent"
					android:layout_height="22dp"
					android:paddingLeft="8dp"
					android:paddingRight="8dp"
					android:maxHeight="4dp"
					android:minHeight="4dp"
					android:splitTrack="false" />
			</LinearLayout>
		</RelativeLayout>
	</FrameLayout>

	<View
		android:id="@+id/view139"
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="#1A1A22" />

	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll16"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:background="#0D0D10"
		android:layout_weight="1"
		android:overScrollMode="never">

		<LinearLayout
			android:id="@+id/linear140"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="16dp"
			android:paddingTop="18dp"
			android:paddingRight="16dp"
			android:paddingBottom="36dp"
			android:orientation="vertical">

			<!-- Header Judul & Metadata Ala YouTube (Klik untuk Detail) -->
			<LinearLayout
				android:id="@+id/layoutHeaderDetail"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<TextView
					android:id="@+id/textJudul"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Memuat Judul..."
					android:textSize="19sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:ellipsize="end"
					android:maxLines="2" />

				<LinearLayout
					android:id="@+id/linear143"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:id="@+id/textRating"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Donghua"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#A1A1AA" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="6dp"
						android:layout_marginRight="6dp"
						android:text="•"
						android:textSize="12sp"
						android:textColor="#71717A" />

					<TextView
						android:id="@+id/textYear"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="2026"
						android:textSize="12sp"
						android:textColor="#A1A1AA" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="6dp"
						android:layout_marginRight="6dp"
						android:text="•"
						android:textSize="12sp"
						android:textColor="#71717A" />

					<TextView
						android:id="@+id/textGenre"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="8dp"
						android:paddingTop="3dp"
						android:paddingRight="8dp"
						android:paddingBottom="3dp"
						android:text="Action"
						android:textSize="11sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />

					<LinearLayout
						android:id="@+id/btnOpenDetail"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="8dp"
						android:paddingLeft="6dp"
						android:paddingTop="3dp"
						android:paddingRight="6dp"
						android:paddingBottom="3dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Detail"
							android:textSize="12sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />

						<ImageView
							android:layout_width="14dp"
							android:layout_height="14dp"
							android:layout_marginLeft="2dp"
							android:src="@drawable/ic_chevron_right" />
					</LinearLayout>
				</LinearLayout>

				<!-- Sinopsis disembunyikan dari layar utama, tampil di Bottom Sheet Detail -->
				<TextView
					android:id="@+id/textSinopsis"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:visibility="gone" />
			</LinearLayout>

			<!-- Bar Tombol Pill Monokrom Putih -->
			<HorizontalScrollView
				android:id="@+id/scrollActionButtons"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:scrollbars="none"
				android:overScrollMode="never">

				<LinearLayout
					android:id="@+id/linearScrollContainer"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal">

					<LinearLayout
						android:id="@+id/btnActionServer"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:paddingLeft="16dp"
						android:paddingRight="16dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageActionServer"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_server" />

						<TextView
							android:id="@+id/textActionServer"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="Server"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/btnActionDownload"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:layout_marginLeft="10dp"
						android:paddingLeft="16dp"
						android:paddingRight="16dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageActionDownload"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_download" />

						<TextView
							android:id="@+id/textActionDownload"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="Unduh"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/btnActionShare"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:layout_marginLeft="10dp"
						android:paddingLeft="16dp"
						android:paddingRight="16dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageActionShare"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_share" />

						<TextView
							android:id="@+id/textActionShare"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="Bagikan"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/btnActionReport"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:layout_marginLeft="10dp"
						android:paddingLeft="16dp"
						android:paddingRight="16dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageActionReport"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_report" />

						<TextView
							android:id="@+id/textActionReport"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="Laporkan"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>
				</LinearLayout>
			</HorizontalScrollView>

			<!-- Header Episode List dengan Filter Terbaru/Terlama & Lihat Semua -->
			<LinearLayout
				android:id="@+id/linear144"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/textview83"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Semua Episode"
					android:textSize="16sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:layout_weight="1" />

				<LinearLayout
					android:id="@+id/btnSortEpisodes"
					android:layout_width="wrap_content"
					android:layout_height="30dp"
					android:layout_marginRight="10dp"
					android:paddingLeft="10dp"
					android:paddingRight="10dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="13dp"
						android:layout_height="13dp"
						android:src="@drawable/ic_sort" />

					<TextView
						android:id="@+id/textSortEpisodes"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="5dp"
						android:text="Terbaru"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/btnSeeAllContainer"
					android:layout_width="wrap_content"
					android:layout_height="30dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:id="@+id/textview85"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Lihat Semua"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#A1A1AA" />

					<ImageView
						android:layout_width="14dp"
						android:layout_height="14dp"
						android:layout_marginLeft="2dp"
						android:src="@drawable/ic_chevron_right"
						app:tint="#A1A1AA" />
				</LinearLayout>
			</LinearLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerEpisode"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:clipToPadding="false"
				android:overScrollMode="never"
				tools:listitem="@layout/eps_list" />

			<TextView
				android:id="@+id/textview84"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="26dp"
				android:text="Rekomendasi Serupa"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerRekomendasi"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:nestedScrollingEnabled="false"
				android:overScrollMode="never" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
