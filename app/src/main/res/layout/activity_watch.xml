<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/rootWatchLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000"
	android:orientation="vertical">

	<FrameLayout
		android:id="@+id/layoutPlayer"
		android:layout_width="match_parent"
		android:layout_height="220dp"
		android:background="#000000"
		android:clipChildren="false"
		android:clipToPadding="false">

		<android.view.TextureView
			android:id="@+id/playerTextureView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_gravity="center" />

		<LinearLayout
			android:id="@+id/animSeekLeft"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical|left"
			android:layout_marginLeft="44dp"
			android:paddingLeft="14dp"
			android:paddingTop="8dp"
			android:paddingRight="14dp"
			android:paddingBottom="8dp"
			android:gravity="center"
			android:orientation="vertical"
			android:alpha="0"
			android:visibility="gone">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="« 10 detik"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/animSeekRight"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical|right"
			android:layout_marginRight="44dp"
			android:paddingLeft="14dp"
			android:paddingTop="8dp"
			android:paddingRight="14dp"
			android:paddingBottom="8dp"
			android:gravity="center"
			android:orientation="vertical"
			android:alpha="0"
			android:visibility="gone">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="10 detik »"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/btnUnlockScreen"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|right"
			android:layout_marginTop="24dp"
			android:layout_marginRight="24dp"
			android:paddingLeft="14dp"
			android:paddingTop="8dp"
			android:paddingRight="14dp"
			android:paddingBottom="8dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:visibility="gone">

			<ImageView
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:src="@drawable/ic_lock"
				android:scaleType="fitCenter" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="6dp"
				android:text="Terkunci"
				android:textSize="12sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
		</LinearLayout>

		<RelativeLayout
			android:id="@+id/playerControlsOverlay"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@android:color/transparent"
			android:clipChildren="false"
			android:clipToPadding="false">

			<View
				android:id="@+id/gradientTop"
				android:layout_width="match_parent"
				android:layout_height="84dp"
				android:clickable="false"
				android:focusable="false"
				android:layout_alignParentTop="true" />

			<View
				android:id="@+id/gradientBottom"
				android:layout_width="match_parent"
				android:layout_height="84dp"
				android:clickable="false"
				android:focusable="false"
				android:layout_alignParentBottom="true" />

			<RelativeLayout
				android:id="@+id/topBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:paddingLeft="16dp"
				android:paddingTop="14dp"
				android:paddingRight="16dp"
				android:paddingBottom="6dp"
				android:clipChildren="false"
				android:clipToPadding="false"
				android:layout_alignParentTop="true">

				<ImageView
					android:id="@+id/btnBack"
					android:layout_width="28dp"
					android:layout_height="28dp"
					android:padding="2dp"
					android:src="@drawable/ic_back_arrow"
					android:scaleType="fitCenter"
					android:layout_alignParentLeft="true"
					android:layout_centerVertical="true" />

				<TextView
					android:id="@+id/textPlayerTitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="12dp"
					android:layout_marginRight="12dp"
					android:paddingTop="2dp"
					android:paddingBottom="2dp"
					android:text="Judul Donghua"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:maxLines="1"
					android:ellipsize="end"
					android:visibility="gone"
					android:layout_toLeftOf="@id/topRightControls"
					android:layout_toRightOf="@id/btnBack"
					android:layout_centerVertical="true" />

				<LinearLayout
					android:id="@+id/topRightControls"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:clipChildren="false"
					android:clipToPadding="false"
					android:layout_alignParentRight="true"
					android:layout_centerVertical="true">

					<LinearLayout
						android:id="@+id/btnFill"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginRight="14dp"
						android:paddingTop="2dp"
						android:paddingBottom="2dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageview4"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:src="@drawable/ic_fill"
							android:scaleType="fitCenter" />

						<TextView
							android:id="@+id/textview4"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="5dp"
							android:text="Fill"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>

					<ImageView
						android:id="@+id/btnCast"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:layout_marginRight="14dp"
						android:src="@drawable/ic_cast"
						android:scaleType="fitCenter" />

										<ImageView
						android:id="@+id/btnLock"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:layout_marginRight="14dp"
						android:src="@drawable/ic_lock"
						android:scaleType="fitCenter"
						android:visibility="gone" />


					<ImageView
						android:id="@+id/btnSettings"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/ic_settings"
						android:scaleType="fitCenter" />
				</LinearLayout>
			</RelativeLayout>

			<ImageView
				android:id="@+id/btnPrevEpisode"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:layout_marginLeft="12dp"
				android:padding="4dp"
				android:src="@drawable/ic_prev"
				android:scaleType="fitCenter"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true" />

			<LinearLayout
				android:id="@+id/centerControls"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:orientation="horizontal"
				android:layout_centerInParent="true">

				<ImageView
					android:id="@+id/btnRewind"
					android:layout_width="36dp"
					android:layout_height="36dp"
					android:padding="5dp"
					android:src="@drawable/ic_rewind"
					android:scaleType="fitCenter" />

				<FrameLayout
					android:id="@+id/frame_layout5"
					android:layout_width="64dp"
					android:layout_height="64dp"
					android:layout_marginLeft="22dp"
					android:layout_marginRight="22dp">

					<ProgressBar
						android:id="@+id/playerLoading"
						android:layout_width="64dp"
						android:layout_height="64dp"
						android:indeterminate="true"
						android:indeterminateTint="#3B82F6"
						android:layout_gravity="center"
						android:visibility="gone" />

					<ImageView
						android:id="@+id/btnPlay"
						android:layout_width="54dp"
						android:layout_height="54dp"
						android:padding="14dp"
						android:src="@drawable/ic_play1"
						android:scaleType="fitCenter"
						android:layout_gravity="center" />
				</FrameLayout>

				<ImageView
					android:id="@+id/btnForward"
					android:layout_width="36dp"
					android:layout_height="36dp"
					android:padding="5dp"
					android:src="@drawable/ic_forward"
					android:scaleType="fitCenter" />
			</LinearLayout>

			<ImageView
				android:id="@+id/btnNextEpisode"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:layout_marginRight="12dp"
				android:padding="4dp"
				android:src="@drawable/ic_next"
				android:scaleType="fitCenter"
				android:layout_alignParentRight="true"
				android:layout_centerVertical="true" />

			<LinearLayout
				android:id="@+id/bottomControls"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="6dp"
				android:orientation="vertical"
				android:layout_alignParentBottom="true">

				<RelativeLayout
					android:id="@+id/relativelayout2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="4dp"
					android:paddingLeft="16dp"
					android:paddingRight="16dp">

					<TextView
						android:id="@+id/textTime"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="00:00 / 00:00"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:layout_alignParentLeft="true"
						android:layout_centerVertical="true" />

					<LinearLayout
						android:id="@+id/linear2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:layout_alignParentRight="true"
						android:layout_centerVertical="true">

						<TextView
							android:id="@+id/btnFullscreenEpisodes"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginRight="14dp"
							android:padding="4dp"
							android:text="Episode"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF"
							android:visibility="gone" />

						<TextView
							android:id="@+id/btnQuality"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="4dp"
							android:text="Auto"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />

						<ImageView
							android:id="@+id/btnFullscreen"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:layout_marginLeft="10dp"
							android:padding="2dp"
							android:src="@drawable/ic_fullscreen"
							android:scaleType="fitCenter" />
					</LinearLayout>
				</RelativeLayout>

				<SeekBar
					android:id="@+id/playerSeekBar"
					android:layout_width="match_parent"
					android:layout_height="22dp"
					android:paddingLeft="8dp"
					android:paddingRight="8dp"
					android:maxHeight="4dp"
					android:minHeight="4dp"
					android:splitTrack="false" />
			</LinearLayout>
		</RelativeLayout>
	</FrameLayout>

	<View
		android:id="@+id/view139"
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="#0B0D11" />

	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll16"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:background="#000000"
		android:layout_weight="1"
		android:overScrollMode="never">

		<LinearLayout
			android:id="@+id/linear140"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="16dp"
			android:paddingTop="18dp"
			android:paddingRight="16dp"
			android:paddingBottom="36dp"
			android:orientation="vertical">

			<LinearLayout
				android:id="@+id/btnOpenDetail"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<androidx.cardview.widget.CardView
					android:id="@+id/cardview1"
					android:layout_width="64dp"
					android:layout_height="64dp"
					app:cardBackgroundColor="#0B0D11"
					app:cardCornerRadius="32dp"
					app:cardElevation="0dp">

					<ImageView
						android:id="@+id/imagePoster"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:src="@drawable/default_image"
						android:scaleType="centerCrop" />
				</androidx.cardview.widget.CardView>

				<LinearLayout
					android:id="@+id/linear142"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginLeft="14dp"
					android:layout_marginRight="8dp"
					android:orientation="vertical">

					<TextView
						android:id="@+id/textJudul"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Memuat Judul..."
						android:textSize="17sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:ellipsize="end"
						android:maxLines="2" />

					<LinearLayout
						android:id="@+id/linear143"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<TextView
							android:id="@+id/textRating"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Ongoing"
							android:textSize="12sp"
							android:textColor="#9CA3AF" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="6dp"
							android:layout_marginRight="6dp"
							android:text="•"
							android:textSize="12sp"
							android:textColor="#6B7280" />

						<TextView
							android:id="@+id/textYear"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="2026"
							android:textSize="12sp"
							android:textColor="#9CA3AF" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="6dp"
							android:layout_marginRight="6dp"
							android:text="•"
							android:textSize="12sp"
							android:textColor="#6B7280" />

						<TextView
							android:id="@+id/textGenre"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Action"
							android:textSize="12sp"
							android:textColor="#9CA3AF" />
					</LinearLayout>
				</LinearLayout>

				<ImageView
					android:id="@+id/iconExpandDetail"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:padding="5dp"
					android:src="@drawable/ic_chevron_down"
					android:scaleType="fitCenter" />
			</LinearLayout>

			<HorizontalScrollView
				android:id="@+id/scrollActionButtons"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:scrollbars="none"
				android:overScrollMode="never">

				<LinearLayout
					android:id="@+id/linearScrollContainer"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal">

					<LinearLayout
						android:id="@+id/btnActionServer"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="16dp"
						android:paddingTop="10dp"
						android:paddingRight="16dp"
						android:paddingBottom="10dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageActionServer"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_server" />

						<TextView
							android:id="@+id/textActionServer"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="Server"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/btnActionDownload"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:paddingLeft="16dp"
						android:paddingTop="10dp"
						android:paddingRight="16dp"
						android:paddingBottom="10dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageActionDownload"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_download" />

						<TextView
							android:id="@+id/textActionDownload"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="Download"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/btnActionShare"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:paddingLeft="16dp"
						android:paddingTop="10dp"
						android:paddingRight="16dp"
						android:paddingBottom="10dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageActionShare"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_share" />

						<TextView
							android:id="@+id/textActionShare"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="Share"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/btnActionReport"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="10dp"
						android:paddingLeft="16dp"
						android:paddingTop="10dp"
						android:paddingRight="16dp"
						android:paddingBottom="10dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<ImageView
							android:id="@+id/imageActionReport"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_report" />

						<TextView
							android:id="@+id/textActionReport"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="8dp"
							android:text="Report"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>
				</LinearLayout>
			</HorizontalScrollView>

			<LinearLayout
				android:id="@+id/linear144"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/textview83"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Episode List"
					android:textSize="16sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:layout_weight="1" />

				<LinearLayout
					android:id="@+id/btnSortEpisodes"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="14dp"
					android:paddingLeft="10dp"
					android:paddingTop="5dp"
					android:paddingRight="10dp"
					android:paddingBottom="5dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:id="@+id/iconSortEpisodes"
						android:layout_width="14dp"
						android:layout_height="14dp"
						android:src="@drawable/ic_sort" />

					<TextView
						android:id="@+id/textSortEpisodes"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="5dp"
						android:text="Terbaru"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#CBD5E1" />
				</LinearLayout>

				<TextView
					android:id="@+id/textview85"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Lihat Semua"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="#3B82F6" />
			</LinearLayout>

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerEpisode"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:clipToPadding="false"
				android:overScrollMode="never"
				tools:listitem="@layout/eps_list" />

			<TextView
				android:id="@+id/textview84"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:text="Rekomendasi Serupa"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerRekomendasi"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:nestedScrollingEnabled="false"
				android:overScrollMode="never" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
