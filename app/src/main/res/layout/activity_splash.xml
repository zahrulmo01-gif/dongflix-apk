<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/splash_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<LinearLayout
		android:id="@+id/splash_center_group"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_centerInParent="true"
		android:gravity="center"
		android:orientation="vertical">

		<ImageView
			android:id="@+id/img_splash_logo"
			android:layout_width="84dp"
			android:layout_height="84dp"
			android:contentDescription="Dongflix"
			android:scaleType="fitCenter"
			android:src="@drawable/img_splash_logo" />

		<TextView
			android:id="@+id/text_splash_brand"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:text="Dongflix"
			android:textColor="#FFFFFF"
			android:textSize="24sp" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/splash_bottom_group"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentBottom="true"
		android:layout_marginBottom="28dp"
		android:gravity="center"
		android:orientation="vertical">

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ProgressBar
				android:id="@+id/splash_spinner"
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:layout_marginRight="8dp"
				android:indeterminate="true"
				android:indeterminateTint="#38BDF8" />

			<TextView
				android:id="@+id/text_splash_status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Menyiapkan aplikasi..."
				android:textColor="#CBD5E1"
				android:textSize="13sp" />
		</LinearLayout>

		<TextView
			android:id="@+id/text_splash_version"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="18dp"
			android:text="V6.0"
			android:textColor="#64748B"
			android:textSize="11.5sp" />
	</LinearLayout>

</RelativeLayout>
